# Royalway One — example environment file
#
# Copy to `server/.env` for local development:
#     cp .env.example server/.env
#
# VARIABLE NAMES ONLY. Never commit real secrets to this file or any other
# file in the repository. On Render, secrets are entered in the dashboard
# (they are declared `sync: false` in render.yaml so Render prompts for them).
#
# Full reference: ENVIRONMENT.md

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=8080

# Signs anonymous session cookies AND download links. Use 32+ random chars.
# Generate one with:  openssl rand -base64 32
# Rotating this invalidates all existing download links.
SESSION_SECRET=

# Where uploads, temp files and outputs are written.
# On Render this must be the mounted disk path (/var/data).
STORAGE_DIR=./.storage

# ---------------------------------------------------------------------------
# Strongly recommended
# ---------------------------------------------------------------------------

# Postgres connection string. Without it the server falls back to a local JSON
# store, which is fine for a single local instance.
DATABASE_URL=

# Enables the /admin dashboard. While unset, every admin route returns 404.
ADMIN_TOKEN=

# Canonical public origin, used for sitemap and canonical SEO URLs.
PUBLIC_URL=

# ---------------------------------------------------------------------------
# AI provider — switches on AI Workspace, Business Tools, Document AI,
# Ask Document, Compare, and all AI-dependent workflows.
# Set ONE of the following. Leave blank to run without AI: the affected tools
# then report themselves as unavailable instead of pretending to work.
# ---------------------------------------------------------------------------

# Option A — OpenAI. This single key ALSO switches on transcription (Whisper).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Override only for Azure OpenAI, a gateway, or an egress proxy.
OPENAI_BASE_URL=

# Option B — Anthropic.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Force a provider when both keys are present: openai | anthropic
AI_PROVIDER=
# Longer documents are truncated before sending, and the UI says so.
AI_MAX_INPUT_CHARS=120000

# ---------------------------------------------------------------------------
# Transcription provider — switches on audio/video transcription.
# Set ONE. Deepgram gives better speaker diarization; OpenAI reuses the key
# above. Leave blank to run without transcription (honest unavailable state).
# ---------------------------------------------------------------------------

DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-2
# Override only for Deepgram on-prem or an egress proxy.
DEEPGRAM_BASE_URL=

OPENAI_TRANSCRIBE_MODEL=whisper-1

# Force a provider: deepgram | openai
TRANSCRIPTION_PROVIDER=

# ---------------------------------------------------------------------------
# Limits, retention and safety (defaults shown)
# ---------------------------------------------------------------------------

FILE_RETENTION_MINUTES=120
MAX_UPLOAD_BYTES=536870912
MAX_MEDIA_SECONDS=14400
MAX_CONCURRENT_JOBS_PER_SESSION=3
WORKER_CONCURRENCY=2

# Whether this process also drains the job queue. Keep true unless you run a
# separate worker service backed by SHARED object storage (see render.yaml).
RUN_WORKER=true

# Allow transcribing a public media URL. SSRF-protected.
URL_INGEST_ENABLED=true
YTDLP_PATH=

# CSP frame-ancestors. Defaults to 'self' in production.
FRAME_ANCESTORS=

# ---------------------------------------------------------------------------
# Optional binaries (auto-detected; override only if needed)
# ---------------------------------------------------------------------------

FFMPEG_PATH=
FFPROBE_PATH=
# If LibreOffice is present, Office<->PDF conversions use it for higher
# fidelity. Without it, library fallbacks are used and the tools still work.
SOFFICE_PATH=
