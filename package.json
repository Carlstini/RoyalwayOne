{
  "name": "royalway-one",
  "private": true,
  "version": "1.0.0",
  "workspaces": ["server", "client"],
  "scripts": {
    "build": "npm run build --workspace client && npm run build --workspace server",
    "start": "npm run start --workspace server",
    "dev": "concurrently -n api,web -c cyan,magenta \"npm:dev --workspace server\" \"npm:dev --workspace client\"",
    "test": "npm run test --workspace server"
  },
  "devDependencies": { "concurrently": "^9.1.0" }
}
